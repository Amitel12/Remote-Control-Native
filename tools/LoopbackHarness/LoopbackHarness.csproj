<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Phase 0 tool (see docs/ARCHITECTURE.md): capture -> encode -> decode ->
    render, single machine, no networking. This is the go/no-go gate for the
    whole rewrite - prove sustained 60fps 1080p with zero CPU-side texture
    copies and a measurable latency win from zero-B-frames/IPPP +
    MF_LOW_LATENCY before building Phase 1+ on top of these assumptions.
    Windows-only; it can be cross-compiled for CI but cannot be run or verified
    outside a real Windows dev machine.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <OutputType>Exe</OutputType>
    <RootNamespace>RemoteControl.Tools.LoopbackHarness</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RemoteControl.Capture\RemoteControl.Capture.csproj" />
    <ProjectReference Include="..\..\src\RemoteControl.Codec\RemoteControl.Codec.csproj" />
    <ProjectReference Include="..\..\src\RemoteControl.Render\RemoteControl.Render.csproj" />
    <ProjectReference Include="..\..\src\RemoteControl.Common\RemoteControl.Common.csproj" />
    <ProjectReference Include="..\..\src\RemoteControl.Net\RemoteControl.Net.csproj" />
    <ProjectReference Include="..\..\src\RemoteControl.Input\RemoteControl.Input.csproj" />
    <ProjectReference Include="..\..\src\RemoteControl.Protocol\RemoteControl.Protocol.csproj" />
    <ProjectReference Include="..\..\src\RemoteControl.Signaling\RemoteControl.Signaling.csproj" />
    <ProjectReference Include="..\..\src\RemoteControl.Session\RemoteControl.Session.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Step 1 verification only (docs/PHASE-0.md): decode one frame back to
      CPU and write a PNG to confirm output correctness. See
      FrameVerifier.cs - kept isolated to that one file and one guarded call
      site so it can be removed without touching the pipeline itself, since
      a readback here would mask the separate zero-copy measurement.
    -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

</Project>
