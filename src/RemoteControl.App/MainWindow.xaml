<Window x:Class="RemoteControl.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote Control" Height="520" Width="640" MinHeight="420" MinWidth="560">
    <!--
        Control panel only. The actual video renders in its own SessionWindow
        (RemoteControl.Session), not embedded here. See docs/PHASE-5.md.
    -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,12">
            <RadioButton x:Name="HostModeRadio" Content="Host this PC" IsChecked="True"
                         GroupName="Mode" Checked="ModeRadio_Checked" Margin="0,0,24,0" />
            <RadioButton x:Name="ClientModeRadio" Content="Connect to a PC"
                         GroupName="Mode" Checked="ModeRadio_Checked" />
        </StackPanel>

        <Grid x:Name="HostPanel" Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Pairing code" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,8,4" />
            <TextBox x:Name="PairingCodeDisplay" Grid.Row="0" Grid.Column="1" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="18" Margin="0,4" Padding="4" />

            <TextBlock Text="Others connect to" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,8,4" />
            <TextBox x:Name="LocalAddressesDisplay" Grid.Row="1" Grid.Column="1" IsReadOnly="True"
                     Margin="0,4" Padding="4" TextWrapping="Wrap" />

            <Button x:Name="StartHostButton" Content="Start Hosting" Grid.Row="2" Grid.Column="1"
                    HorizontalAlignment="Left" Padding="16,6" Margin="0,8,0,0" Click="StartHostButton_Click" />
        </Grid>

        <Grid x:Name="ClientPanel" Grid.Row="1" Margin="0,0,0,8" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Host address" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,8,4" />
            <TextBox x:Name="HostAddressBox" Grid.Row="0" Grid.Column="1" Margin="0,4" Padding="4" />

            <TextBlock Text="Pairing code" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,8,4" />
            <TextBox x:Name="PairingCodeBox" Grid.Row="1" Grid.Column="1" Margin="0,4" Padding="4"
                     FontFamily="Consolas" CharacterCasing="Upper" />

            <Button x:Name="ConnectButton" Content="Connect" Grid.Row="2" Grid.Column="1"
                    HorizontalAlignment="Left" Padding="16,6" Margin="0,8,0,0" Click="ConnectButton_Click" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,4,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Idle" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" />
            <Button x:Name="StopButton" Content="Stop" Grid.Column="1" Padding="16,6" IsEnabled="False" Click="StopButton_Click" />
        </Grid>

        <Expander Header="Settings" Grid.Row="3" Margin="0,0,0,8">
            <StackPanel Margin="8">
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="STUN server" Width="100" VerticalAlignment="Center" />
                    <TextBox x:Name="StunServerBox" Width="220" Text="stun.l.google.com:19302" />
                </StackPanel>
                <CheckBox x:Name="RemoteInputCheck" Content="Allow remote mouse/keyboard" IsChecked="True" Margin="0,4" />
                <CheckBox x:Name="AdaptiveBitrateCheck" Content="Adaptive bitrate" IsChecked="True" Margin="0,4" />
                <CheckBox x:Name="AdaptiveFecCheck" Content="Adaptive FEC" IsChecked="True" Margin="0,4" />
            </StackPanel>
        </Expander>

        <Border Grid.Row="4" BorderBrush="#CCC" BorderThickness="1">
            <ListBox x:Name="LogListBox" FontFamily="Consolas" FontSize="11"
                     SelectionMode="Extended" SelectionChanged="LogListBox_SelectionChanged"
                     ToolTip="Click a line (or drag to select several) to copy it" />
        </Border>
    </Grid>
</Window>
